#!/usr/bin/env python3
"""BenjaBreeze — controle de ventoinhas para notebooks Acer Predator (driver acer_wmi hwmon).

Uso:
  benjabreeze status            mostra temperaturas, RPM e modo
  benjabreeze auto              devolve o controle ao firmware (padrão Acer)
  benjabreeze curve             usa a curva normal do arquivo de config
  benjabreeze silent            usa a curva silenciosa
  benjabreeze max               100% nas duas ventoinhas
  benjabreeze set <0-100>       velocidade fixa (%), qualquer valor
  benjabreeze min <0-100>       velocidade mínima: nunca abaixo de N%, mas sobe
                                 seguindo a curva se esquentar e depois volta
  benjabreeze watch             status atualizando a cada segundo
  benjabreeze unit <C|F>        mostra temperaturas em Celsius ou Fahrenheit (fica salvo)
  benjabreeze lang <código>     idioma: auto, pt_BR, en_US, es, de, fr, ru, ja, ko,
                                zh_TW, zh_CN (fica salvo)
  benjabreeze --version         mostra a versão
  benjabreeze daemon            (usado pelo systemd)
"""
import glob
import json
import os
import signal
import sys
import time

VERSION = "0.9.0"
CONF = "/etc/benjabreeze.json"
RUN_DIR = "/run/benjabreeze"          # tmpfs (RAM): nada é gravado em disco
MODE_FILE = RUN_DIR + "/mode"
DEFAULT_CONF = {
    "interval": 2.0,
    "hysteresis": 4,          # °C que a temperatura precisa cair antes de reduzir
    "panic_temp": 92,         # acima disso: 100% em qualquer modo exceto auto
    "warn_temp": 85,          # modo set fixo: avisa (ícone e journal) a partir daqui
    "default_mode": "auto",
    "min_curve": "curve",     # curva usada acima do mínimo no modo min
    "curves": {               # [temperatura °C, velocidade %], interpolação linear
        "curve":  [[45, 25], [60, 40], [70, 55], [80, 75], [88, 100]],
        "silent": [[50, 15], [65, 30], [75, 45], [85, 70], [90, 100]],
    },
}


# ---------------------------------------------------------------- sysfs
def find_hwmon(name):
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            with open(f"{h}/name") as f:
                if f.read().strip() == name:
                    return h
        except OSError:
            pass
    return None


def rd(path):
    with open(path) as f:
        return int(f.read().strip())


def wr(path, val):
    with open(path, "w") as f:
        f.write(str(int(val)))


def sensor_paths():
    """Resolve uma vez os arquivos de temperatura (acer_wmi + pacote da CPU)."""
    paths = {}
    acer = find_hwmon("acer")
    if acer:
        for p in sorted(glob.glob(f"{acer}/temp*_input")):
            paths["acer_" + os.path.basename(p).split("_")[0]] = p
    core = find_hwmon("coretemp")
    if core and os.path.exists(f"{core}/temp1_input"):
        paths["cpu_pkg"] = f"{core}/temp1_input"
    return paths


def temps(paths=None):
    """Lê as temperaturas (°C). Passe `paths` já resolvido para não varrer o sysfs."""
    out = {}
    for k, p in (paths if paths is not None else sensor_paths()).items():
        try:
            out[k] = rd(p) / 1000
        except OSError:
            pass
    return out


# ---------------------------------------------------------------- config
def load_conf():
    c = json.loads(json.dumps(DEFAULT_CONF))
    try:
        with open(CONF) as f:
            user = json.load(f)
        c.update({k: v for k, v in user.items() if k != "curves"})
        c["curves"].update(user.get("curves", {}))
    except FileNotFoundError:
        pass
    except Exception as e:
        print(f"config inválida ({e}), usando padrão", file=sys.stderr)
    return c


class Config:
    """Só relê o arquivo de configuração quando ele muda."""

    def __init__(self):
        self.mtime, self.data = None, None

    def get(self):
        try:
            m = os.stat(CONF).st_mtime
        except OSError:
            m = 0
        if m != self.mtime:
            self.data, self.mtime = load_conf(), m
        return self.data


# ---------------------------------------------------------------- preferências do usuário
DEFAULT_SETTINGS = {"unit": "C", "lang": "auto"}


def settings_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "benjabreeze", "settings.json")


def load_settings():
    s = dict(DEFAULT_SETTINGS)
    try:
        with open(settings_path()) as f:
            s.update(json.load(f))
    except (OSError, ValueError):
        pass
    if s.get("unit") not in ("C", "F"):
        s["unit"] = "C"
    return s


def save_settings(**changes):
    s = load_settings()
    s.update(changes)
    path = settings_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=2)
    os.replace(tmp, path)
    return s


# ---------------------------------------------------------------- idiomas
LANGS = [
    ("pt_BR", "Português (Brasil)"), ("en_US", "English (US)"), ("es", "Español"),
    ("de", "Deutsch"), ("fr", "Français"), ("ru", "Русский"), ("ja", "日本語"),
    ("ko", "한국어"), ("zh_TW", "繁體中文"), ("zh_CN", "简体中文"),
]
_I18N = None
_LANG = None


def system_lang():
    """Idioma do sistema mapeado para um dos suportados (padrão: inglês)."""
    for var in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(var, "").split(":")[0].split(".")[0]
        if not v or v in ("C", "POSIX"):
            continue
        low = v.lower().replace("-", "_")
        if low.startswith("zh"):
            return "zh_TW" if any(x in low for x in ("tw", "hk", "mo", "hant")) else "zh_CN"
        for code, _ in LANGS:
            if low.split("_")[0] == code.lower().split("_")[0]:
                return code
    return "en_US"


def set_lang(setting):
    global _LANG
    codes = [c for c, _ in LANGS]
    _LANG = setting if setting in codes else system_lang()
    return _LANG


def _load_i18n():
    global _I18N
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(here, "i18n.json"), "/usr/local/share/benjabreeze/i18n.json"):
        try:
            with open(path, encoding="utf-8") as f:
                _I18N = json.load(f)
                return
        except (OSError, ValueError):
            pass
    _I18N = {}


def tr(key, **kw):
    """Texto traduzido. Se faltar no idioma, usa inglês, depois português, depois a chave."""
    if _I18N is None:
        _load_i18n()
    if _LANG is None:
        set_lang(load_settings().get("lang", "auto"))
    for lang in (_LANG, "en_US", "pt_BR"):
        text = _I18N.get(lang, {}).get(key)
        if text is not None:
            return text.format(**kw) if kw else text
    return key


def to_unit(c, unit):
    return c * 9 / 5 + 32 if unit == "F" else c


def fmt_temp(c, unit="C"):
    return "?" if c is None else f"{to_unit(c, unit):.0f}°{unit}"


def read_mode(default):
    try:
        with open(MODE_FILE) as f:
            return f.read().strip() or default
    except OSError:
        return default


def service_running():
    # O systemd cria /run/benjabreeze quando o serviço sobe e apaga quando para.
    return os.path.exists(MODE_FILE)


def valid_mode(m, conf):
    if m in ("auto", "max") or m in conf["curves"]:
        return True
    if m.startswith(("fixed:", "min:")):
        try:
            return 0 <= int(m.split(":", 1)[1]) <= 100
        except ValueError:
            return False
    return False


# ---------------------------------------------------------------- lógica
def interp(curve, t):
    pts = sorted(curve)
    if t <= pts[0][0]:
        return pts[0][1]
    for (t0, s0), (t1, s1) in zip(pts, pts[1:]):
        if t <= t1:
            return s0 + (s1 - s0) * (t - t0) / (t1 - t0)
    return pts[-1][1]


def compute_target(mode, tmax, conf, st):
    """Velocidade alvo (%) para o modo e a temperatura máxima atual.

    `st` guarda o estado da histerese entre chamadas (zere ao trocar de modo).
    """
    if tmax is None or tmax >= conf["panic_temp"] or mode == "max":
        return 100
    if mode.startswith("fixed:"):
        return int(mode[6:])
    ref = st.get("ref")
    if ref is None or tmax > ref:
        ref = tmax
    elif tmax < ref - conf["hysteresis"]:
        ref = tmax + conf["hysteresis"]
    st["ref"] = ref
    if mode.startswith("min:"):
        curve = conf["curves"].get(conf.get("min_curve"), DEFAULT_CONF["curves"]["curve"])
        return max(int(mode[4:]), min(100, round(interp(curve, ref))))
    return max(0, min(100, round(interp(conf["curves"][mode], ref))))


# ---------------------------------------------------------------- daemon
def daemon():
    if os.geteuid() != 0:
        sys.exit("daemon precisa rodar como root")
    hw = find_hwmon("acer")
    if not hw:
        sys.exit("hwmon 'acer' não encontrado (módulo acer_wmi carregado?)")
    fans = [p[:-len("_enable")] for p in sorted(glob.glob(f"{hw}/pwm[0-9]_enable"))]
    sensors = sensor_paths()

    def set_auto():
        for f in fans:
            try:
                wr(f"{f}_enable", 2)
            except OSError:
                pass

    def bye(*_):
        set_auto()
        sys.exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)

    cfg = Config()
    conf = cfg.get()
    os.makedirs(RUN_DIR, exist_ok=True)
    if not os.path.exists(MODE_FILE):
        with open(MODE_FILE, "w") as f:
            f.write(conf["default_mode"])
    os.chmod(MODE_FILE, 0o666)  # permite trocar modo sem sudo (valor é validado)

    last_mode, cur_pct, st, warned = None, None, {}, False
    try:
        while True:
            conf = cfg.get()
            mode = read_mode(conf["default_mode"])
            if not valid_mode(mode, conf):
                mode = conf["default_mode"]

            if mode == "auto":
                # Firmware no controle: não lê sensores nem escreve nada,
                # só confere se o modo mudou.
                if last_mode != "auto":
                    set_auto()
                last_mode, cur_pct, st = "auto", None, {}
                time.sleep(conf["interval"])
                continue

            if mode != last_mode:
                st, warned = {}, False
            t = temps(sensors)
            tmax = max(t.values()) if t else None
            target = compute_target(mode, tmax, conf, st)
            if mode.startswith("fixed:") and tmax is not None:
                if not warned and tmax >= conf["warn_temp"]:
                    print(f"aviso: {tmax:.0f}°C com velocidade fixa em {mode[6:]}% — "
                          f"considere aumentar ou usar 'benjabreeze min {mode[6:]}'",
                          file=sys.stderr, flush=True)
                    warned = True
                elif warned and tmax < conf["warn_temp"] - 5:
                    warned = False
            if target != cur_pct or mode != last_mode:
                for f in fans:
                    if rd(f"{f}_enable") != 1:
                        wr(f"{f}_enable", 1)
                    wr(f, round(target * 255 / 100))
                cur_pct = target
            last_mode = mode
            time.sleep(conf["interval"])
    except Exception as e:
        print(f"erro: {e} — devolvendo ao firmware", file=sys.stderr)
        set_auto()
        raise


# ---------------------------------------------------------------- CLI
def status():
    hw = find_hwmon("acer")
    t = temps()
    unit = load_settings()["unit"]
    print(f"{tr('temps')}: " + "  ".join(f"{k}={fmt_temp(v, unit)}" for k, v in t.items()))
    if hw:
        for i in (1, 2):
            try:
                rpm = rd(f"{hw}/fan{i}_input")
                pwm = rd(f"{hw}/pwm{i}")
                en = rd(f"{hw}/pwm{i}_enable")
                ctl = tr("ctl_manual") if en == 1 else tr("ctl_firmware")
                print(f"{tr('fan')} {i} ({'CPU' if i == 1 else 'GPU'}): {rpm:5d} RPM  "
                      f"pwm={pwm * 100 // 255:3d}%  {ctl}")
            except OSError:
                pass
    active = service_running()
    print(f"{tr('service')}: {tr('active') if active else tr('stopped')}   "
          f"{tr('mode', m=read_mode('?') if active else '-')}")


def set_mode(m):
    conf = load_conf()
    if not valid_mode(m, conf):
        sys.exit(tr("invalid_mode", m=m))
    if not service_running():
        sys.exit(tr("svc_not_running_cli"))
    try:
        with open(MODE_FILE, "w") as f:
            f.write(m)
    except OSError as e:
        sys.exit(f"não consegui trocar o modo: {e}")
    print(tr("mode_set", m=m))


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
    elif a[0] in ("-v", "--version", "version"):
        print(f"benjabreeze {VERSION}")
    elif a[0] == "daemon":
        daemon()
    elif a[0] == "status":
        status()
    elif a[0] == "watch":
        try:
            while True:
                print("\033[H\033[J", end="")
                status()
                time.sleep(1)
        except KeyboardInterrupt:
            pass
    elif a[0] == "unit":
        if len(a) != 2 or a[1].upper() not in ("C", "F"):
            sys.exit(tr("unit_usage"))
        save_settings(unit=a[1].upper())
        print(tr("unit_set", u=a[1].upper()))
    elif a[0] == "lang":
        codes = ["auto"] + [c for c, _ in LANGS]
        if len(a) != 2 or a[1] not in codes:
            sys.exit(tr("lang_usage") + "\n  " + "\n  ".join(
                ["auto"] + [f"{c:6} {n}" for c, n in LANGS]))
        save_settings(lang=a[1])
        set_lang(a[1])
        print(tr("lang_set", l=dict(LANGS).get(_LANG, _LANG)))
    elif a[0] == "set" and len(a) == 2:
        set_mode(f"fixed:{a[1].rstrip('%')}")
    elif a[0] == "min" and len(a) == 2:
        set_mode(f"min:{a[1].rstrip('%')}")
    else:
        set_mode(a[0])


if __name__ == "__main__":
    main()
