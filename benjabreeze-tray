#!/usr/bin/env python3
"""benjabreeze-tray — ícone na bandeja do BenjaBreeze (PyQt6).

Mostra a temperatura no ícone e permite trocar o modo das ventoinhas
pelo menu. Depende do serviço benjabreeze estar rodando. Fechar o ícone
não para o serviço: as ventoinhas continuam no modo escolhido.
"""
import importlib.machinery
import importlib.util
import os
import shutil
import subprocess
import sys

from PyQt6.QtCore import QProcess, QTimer, Qt, QRectF
from PyQt6.QtGui import QAction, QActionGroup, QColor, QFont, QIcon, QPainter, QPixmap
from PyQt6.QtWidgets import QApplication, QMenu, QSystemTrayIcon

# Reaproveita as funções do script principal (mesma pasta ou /usr/local/bin)
_here = os.path.dirname(os.path.realpath(__file__))
for _p in (os.path.join(_here, "benjabreeze"), "/usr/local/bin/benjabreeze"):
    if os.path.exists(_p):
        _loader = importlib.machinery.SourceFileLoader("benjabreeze", _p)
        _spec = importlib.util.spec_from_loader("benjabreeze", _loader)
        pf = importlib.util.module_from_spec(_spec)
        _loader.exec_module(pf)
        break
else:
    sys.exit("benjabreeze não encontrado")

tr = pf.tr

MODES = ["auto", "curve", "silent", "max"]   # rótulos em i18n.json: mode_<nome>
FIXED = [30, 50, 70]
MINIMUM = [30, 40, 50, 60]


def mode_label(mode):
    if mode.startswith("fixed:"):
        return tr("mode_fixed", n=mode[6:])
    if mode.startswith("min:"):
        return tr("mode_min", n=mode[4:])
    if mode in MODES:
        return tr("mode_" + mode)
    return mode


# Escala de cores de temperatura (estilo mapa meteorológico / câmera térmica):
# do azul gelo ao vermelho vulcão. (limite superior °C, fundo, texto)
TEMP_SCALE = [
    (30, "#1E3A8A", "#FFFFFF"),    # nevasca
    (40, "#1D4ED8", "#FFFFFF"),    # frio
    (50, "#0891B2", "#FFFFFF"),    # fresco
    (60, "#16A34A", "#FFFFFF"),    # confortável
    (70, "#84CC16", "#1A1A1A"),    # morno
    (80, "#FACC15", "#1A1A1A"),    # quente
    (85, "#F97316", "#1A1A1A"),    # muito quente
    (92, "#DC2626", "#FFFFFF"),    # perigo
    (999, "#7F1D1D", "#FFFFFF"),   # vulcão: ventoinhas no máximo
]
VOLCANO_BORDER = "#FDE047"
UNKNOWN = ("#6B7280", "#FFFFFF")


def temp_colors(t):
    """(fundo, texto) para a temperatura em °C."""
    if t is None:
        return UNKNOWN
    for limit, bg, fg in TEMP_SCALE:
        if t < limit:
            return bg, fg
    return TEMP_SCALE[-1][1:]


def make_icon(t, unit="C"):
    bg, fg = temp_colors(t)
    pm = QPixmap(64, 64)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QColor(bg))
    if t is not None and t >= TEMP_SCALE[-2][0]:
        pen = p.pen()
        pen.setColor(QColor(VOLCANO_BORDER))
        pen.setWidth(5)
        p.setPen(pen)
    else:
        p.setPen(Qt.PenStyle.NoPen)
    p.drawRoundedRect(QRectF(3, 3, 58, 58), 14, 14)
    p.setPen(QColor(fg))
    f = QFont()
    f.setBold(True)
    text = "?" if t is None else f"{pf.to_unit(t, unit):.0f}"
    f.setPixelSize(36 if len(text) <= 2 else 27)
    p.setFont(f)
    p.drawText(pm.rect(), Qt.AlignmentFlag.AlignCenter, text)
    p.end()
    return QIcon(pm)


INTERVAL_ACTIVE = 2000   # ms — modos manuais/curvas
INTERVAL_AUTO = 5000     # ms — firmware no controle: atualiza menos


class Tray:
    def __init__(self, app):
        self.app = app
        self.sensors = pf.sensor_paths()       # resolvido uma vez
        self.hw = pf.find_hwmon("acer")
        self.last_icon_temp = object()
        self.last_tip = None
        self.cfg = pf.Config()
        self.warned = False
        self.warn_mode = None
        self.settings = pf.load_settings()
        pf.set_lang(self.settings["lang"])

        self.tray = QSystemTrayIcon(make_icon(None))
        self.menu = QMenu()
        self.menu.setToolTipsVisible(True)

        title = self.menu.addAction(f"BenjaBreeze {pf.VERSION}")
        title.setEnabled(False)
        tf = title.font()
        tf.setBold(True)
        title.setFont(tf)
        self.menu.addSeparator()

        self.info = [self.menu.addAction("") for _ in range(4)]
        for a in self.info:
            a.setEnabled(False)
        self.menu.addSeparator()

        # Modos
        self.group = QActionGroup(self.menu)
        self.group.setExclusive(True)
        self.actions = {}
        for key in MODES:
            self.actions[key] = self._mode_action(self.menu, key)
        self.min_menu = self.menu.addMenu("")
        for pct in MINIMUM:
            self.actions[f"min:{pct}"] = self._mode_action(self.min_menu, f"min:{pct}", f"{pct}%")
        self.fixed_menu = self.menu.addMenu("")
        for pct in FIXED:
            self.actions[f"fixed:{pct}"] = self._mode_action(self.fixed_menu, f"fixed:{pct}", f"{pct}%")
        self.menu.addSeparator()

        # Preferências
        self.unit_menu = self.menu.addMenu("")
        self.unit_actions = self._choice_menu(
            self.unit_menu, ["C", "F"], self.settings["unit"], self.set_unit)
        self.lang_menu = self.menu.addMenu("")
        self.lang_actions = self._choice_menu(
            self.lang_menu, ["auto"] + [c for c, _ in pf.LANGS], self.settings["lang"], self.set_language)
        self.menu.addSeparator()
        self.hide_act = self.menu.addAction("")   # esconde só o ícone; o serviço continua
        self.hide_act.triggered.connect(app.quit)
        self.power_act = self.menu.addAction("")  # desliga/liga o serviço (pede senha)
        self.power_act.triggered.connect(self.toggle_service)
        self.proc = None

        self.retranslate()
        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(self._on_click)
        self.tray.messageClicked.connect(self._on_message_click)
        self.tray.show()

        self.menu.aboutToShow.connect(self.refresh)  # dados frescos ao abrir o menu
        self.timer = QTimer()
        self.timer.timeout.connect(self.refresh)
        self.timer.start(INTERVAL_ACTIVE)
        self.refresh()
        QTimer.singleShot(0, self.start_if_stopped)

    # ---------------------------------------------------------- construção do menu
    def _mode_action(self, menu, key, label=""):
        a = QAction(label, menu, checkable=True)
        a.triggered.connect(lambda _=False, k=key: self.set_mode(k))
        self.group.addAction(a)
        menu.addAction(a)
        return a

    def _choice_menu(self, menu, keys, current, callback):
        group = QActionGroup(menu)
        acts = {}
        for k in keys:
            a = QAction("", menu, checkable=True)
            a.setChecked(k == current)
            a.triggered.connect(lambda _=False, k=k: callback(k))
            group.addAction(a)
            menu.addAction(a)
            acts[k] = a
        return acts

    def retranslate(self):
        for key in MODES:
            self.actions[key].setText(mode_label(key))
        self.min_menu.setTitle(tr("menu_min"))
        self.fixed_menu.setTitle(tr("menu_fixed"))
        self.unit_menu.setTitle(tr("menu_unit"))
        self.unit_actions["C"].setText(tr("celsius"))
        self.unit_actions["F"].setText(tr("fahrenheit"))
        self.lang_menu.setTitle(tr("menu_lang"))
        self.lang_actions["auto"].setText(tr("lang_auto"))
        for code, name in pf.LANGS:          # cada idioma no próprio idioma
            self.lang_actions[code].setText(name)
        self.hide_act.setText(tr("hide"))
        self.hide_act.setToolTip(tr("hide_tip"))
        self.update_power_action()

    # ---------------------------------------------------------- eventos
    def _on_click(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            self.menu.popup(self.tray.geometry().center())

    def _on_message_click(self):
        # Clicar no aviso: troca "fixo N%" por "mínimo N%" (sobe se esquentar)
        mode = pf.read_mode("")
        if self.warned and mode.startswith("fixed:"):
            self.set_mode("min:" + mode[6:])

    def check_warning(self, mode, tmax):
        """No modo fixo, avisa uma vez quando passa de warn_temp; rearma 5 °C abaixo."""
        if not mode.startswith("fixed:") or tmax is None:
            self.warned = False
            return
        if mode != self.warn_mode:
            self.warned, self.warn_mode = False, mode
        warn = self.cfg.get()["warn_temp"]
        if not self.warned and tmax >= warn:
            self.tray.showMessage(
                tr("warn_title"),
                tr("warn_body", t=pf.fmt_temp(tmax, self.settings["unit"]), n=mode[6:]),
                QSystemTrayIcon.MessageIcon.Warning,
                10000,
            )
            self.warned = True
        elif self.warned and tmax < warn - 5:
            self.warned = False

    # ---------------------------------------------------------- ações
    def update_power_action(self, active=None):
        if active is None:
            active = pf.service_running()
        self.power_act.setText(tr("power_off") if active else tr("power_on"))
        self.power_act.setToolTip(tr("power_off_tip") if active else "")

    def start_if_stopped(self):
        """Abrir o app depois de "Desligar" liga o serviço de novo (de onde parou).

        Só se o serviço estiver habilitado no boot — se alguém o desabilitou de
        propósito, não insiste (nem pede senha a cada login).
        """
        if pf.service_running():
            return
        enabled = subprocess.run(["systemctl", "is-enabled", "--quiet", "benjabreeze"]).returncode == 0
        if enabled:
            self.toggle_service()

    def toggle_service(self):
        """Desliga (volta ao firmware e fecha o ícone) ou liga o serviço.

        Usa systemctl, que pede a senha pela janela do KDE (polkit).
        """
        if self.proc is not None:
            return
        stopping = pf.service_running()
        self.proc = QProcess()
        self.proc.finished.connect(lambda code, _st: self._service_done(stopping, code))
        self.proc.start("systemctl", ["stop" if stopping else "start", "benjabreeze"])

    def _service_done(self, stopping, code):
        self.proc = None
        if code != 0:                      # senha cancelada ou erro
            self.tray.showMessage("BenjaBreeze", tr("power_fail"),
                                  QSystemTrayIcon.MessageIcon.Warning)
            self.update_power_action()
            return
        if stopping:
            self.notify(tr("off_title"), tr("off_body"))
        else:
            self.last_tip = None
            self.refresh()

    def notify(self, title, body):
        """Notificação do sistema que continua visível depois que o ícone fecha."""
        if shutil.which("notify-send"):
            QProcess.startDetached("notify-send", ["-a", "BenjaBreeze", "-i", "temperature-normal",
                                                   title, body])
            self.app.quit()
        else:
            self.tray.showMessage(title, body, QSystemTrayIcon.MessageIcon.Information, 8000)
            QTimer.singleShot(8000, self.app.quit)

    def set_unit(self, unit):
        self.settings = pf.save_settings(unit=unit)
        self.last_icon_temp, self.last_tip = object(), None
        self.refresh()

    def set_language(self, lang):
        self.settings = pf.save_settings(lang=lang)
        pf.set_lang(lang)
        self.last_tip = None
        self.retranslate()
        self.refresh()

    def update_mode_checks(self, mode=None, active=None):
        if active is None:
            active = pf.service_running()
        if mode is None:
            mode = pf.read_mode("?") if active else ""
        for key, a in self.actions.items():
            a.setChecked(key == mode)
            a.setEnabled(active)

    def set_mode(self, mode):
        try:
            with open(pf.MODE_FILE, "w") as f:
                f.write(mode)
        except OSError:
            self.tray.showMessage("BenjaBreeze", tr("svc_not_running"),
                                  QSystemTrayIcon.MessageIcon.Warning)
        self.refresh()

    def refresh(self):
        t = pf.temps(self.sensors)
        tmax = max(t.values()) if t else None
        fans = []
        if self.hw:
            for i in (1, 2):
                try:
                    fans.append(pf.rd(f"{self.hw}/fan{i}_input"))
                except OSError:
                    fans.append(None)
        active = pf.service_running()
        mode = pf.read_mode("?") if active else ""
        want = INTERVAL_AUTO if mode in ("auto", "") else INTERVAL_ACTIVE
        if self.timer.interval() != want:
            self.timer.setInterval(want)

        unit = self.settings["unit"]
        lines = [
            tr("cpu", t=pf.fmt_temp(t.get("cpu_pkg"), unit)),
            tr("max_sensors", t=pf.fmt_temp(tmax, unit)),
            tr("fans", v=" / ".join(f"{r} RPM" if r is not None else "?" for r in fans)),
            tr("mode", m=mode_label(mode) if active else tr("service_stopped")),
        ]
        self.check_warning(mode, tmax)
        for a, txt in zip(self.info, lines):
            a.setText(txt)
        self.update_mode_checks(mode, active)
        self.update_power_action(active)

        # Só redesenha/atualiza quando algo visível mudou
        icon_temp = None if tmax is None else round(tmax)
        if (icon_temp, unit) != self.last_icon_temp:
            self.tray.setIcon(make_icon(icon_temp, unit=unit))
            self.last_icon_temp = (icon_temp, unit)
        tip = "BenjaBreeze\n" + "\n".join(lines)
        if tip != self.last_tip:
            self.tray.setToolTip(tip)
            self.last_tip = tip


def main():
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    app.setApplicationName("benjabreeze-tray")
    if not QSystemTrayIcon.isSystemTrayAvailable():
        sys.exit("bandeja do sistema não disponível")
    _t = Tray(app)  # noqa: F841 (mantém referência viva)
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
