#!/usr/bin/env python3
"""benjabreeze-tray — ícone na bandeja do BenjaBreeze (PyQt6).

Mostra a temperatura no ícone e permite trocar o modo das ventoinhas
pelo menu. Depende do serviço benjabreeze estar rodando.
"""
import importlib.machinery
import importlib.util
import os
import sys

from PyQt6.QtCore import QTimer, Qt, QRectF
from PyQt6.QtGui import QAction, QActionGroup, QColor, QFont, QIcon, QPainter, QPixmap
from PyQt6.QtWidgets import QApplication, QMenu, QSystemTrayIcon

# Reaproveita as funções do script principal (mesma pasta ou /usr/local/bin)
_here = os.path.dirname(os.path.realpath(__file__))
for _p in (os.path.join(_here, "benjabreeze"), "/usr/local/bin/benjabreeze"):
    if os.path.exists(_p):
        _loader = importlib.machinery.SourceFileLoader("benjabreeze", _p)
        _spec = importlib.util.spec_from_loader("benjabreeze", _loader)
        pf = importlib.util.module_from_spec(_spec)
        _loader.exec_module(pf)
        break
else:
    sys.exit("benjabreeze não encontrado")

MODES = [
    ("auto", "Automático (firmware Acer)"),
    ("curve", "Curva normal"),
    ("silent", "Silencioso"),
    ("max", "Máximo (100%)"),
]
FIXED = [30, 50, 70]
MINIMUM = [30, 40, 50, 60]


def mode_label(mode):
    if mode.startswith("fixed:"):
        return f"Fixo {mode[6:]}%"
    if mode.startswith("min:"):
        return f"Mínimo {mode[4:]}%"
    return dict(MODES).get(mode, mode)


# Escala de cores de temperatura (estilo mapa meteorológico / câmera térmica):
# do azul gelo ao vermelho vulcão. (limite superior °C, fundo, texto)
TEMP_SCALE = [
    (30, "#1E3A8A", "#FFFFFF"),    # nevasca
    (40, "#1D4ED8", "#FFFFFF"),    # frio
    (50, "#0891B2", "#FFFFFF"),    # fresco
    (60, "#16A34A", "#FFFFFF"),    # confortável
    (70, "#84CC16", "#1A1A1A"),    # morno
    (80, "#FACC15", "#1A1A1A"),    # quente
    (85, "#F97316", "#1A1A1A"),    # muito quente
    (92, "#DC2626", "#FFFFFF"),    # perigo
    (999, "#7F1D1D", "#FFFFFF"),   # vulcão: ventoinhas no máximo
]
VOLCANO_BORDER = "#FDE047"
UNKNOWN = ("#6B7280", "#FFFFFF")


def temp_colors(t):
    """(fundo, texto) para a temperatura em °C."""
    if t is None:
        return UNKNOWN
    for limit, bg, fg in TEMP_SCALE:
        if t < limit:
            return bg, fg
    return TEMP_SCALE[-1][1:]


def make_icon(t):
    bg, fg = temp_colors(t)
    pm = QPixmap(64, 64)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QColor(bg))
    if t is not None and t >= TEMP_SCALE[-2][0]:
        pen = p.pen()
        pen.setColor(QColor(VOLCANO_BORDER))
        pen.setWidth(5)
        p.setPen(pen)
    else:
        p.setPen(Qt.PenStyle.NoPen)
    p.drawRoundedRect(QRectF(3, 3, 58, 58), 14, 14)
    p.setPen(QColor(fg))
    f = QFont()
    f.setBold(True)
    f.setPixelSize(36)
    p.setFont(f)
    p.drawText(pm.rect(), Qt.AlignmentFlag.AlignCenter, "?" if t is None else f"{t:.0f}")
    p.end()
    return QIcon(pm)


INTERVAL_ACTIVE = 2000   # ms — modos manuais/curvas
INTERVAL_AUTO = 5000     # ms — firmware no controle: atualiza menos


class Tray:
    def __init__(self, app):
        self.app = app
        self.sensors = pf.sensor_paths()       # resolvido uma vez
        self.hw = pf.find_hwmon("acer")
        self.last_icon_temp = object()
        self.last_tip = None
        self.cfg = pf.Config()
        self.warned = False
        self.warn_mode = None
        self.tray = QSystemTrayIcon(make_icon(None))
        self.menu = QMenu()

        title = self.menu.addAction(f"BenjaBreeze {pf.VERSION}")
        title.setEnabled(False)
        tf = title.font()
        tf.setBold(True)
        title.setFont(tf)
        self.menu.addSeparator()

        self.info = [self.menu.addAction("") for _ in range(4)]
        for a in self.info:
            a.setEnabled(False)
        self.menu.addSeparator()

        self.group = QActionGroup(self.menu)
        self.group.setExclusive(True)
        self.actions = {}
        for key, label in MODES:
            self.actions[key] = self._mode_action(self.menu, key, label)
        sub = self.menu.addMenu("Velocidade mínima")
        for pct in MINIMUM:
            key = f"min:{pct}"
            self.actions[key] = self._mode_action(sub, key, f"{pct}%")
        sub = self.menu.addMenu("Velocidade fixa")
        for pct in FIXED:
            key = f"fixed:{pct}"
            self.actions[key] = self._mode_action(sub, key, f"{pct}%")

        self.menu.addSeparator()
        quit_act = self.menu.addAction("Fechar ícone")
        quit_act.triggered.connect(app.quit)

        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(self._on_click)
        self.tray.messageClicked.connect(self._on_message_click)
        self.tray.show()

        self.menu.aboutToShow.connect(self.refresh)  # dados frescos ao abrir o menu
        self.timer = QTimer()
        self.timer.timeout.connect(self.refresh)
        self.timer.start(INTERVAL_ACTIVE)
        self.refresh()

    def _mode_action(self, menu, key, label):
        a = QAction(label, menu, checkable=True)
        a.triggered.connect(lambda _=False, k=key: self.set_mode(k))
        self.group.addAction(a)
        menu.addAction(a)
        return a

    def _on_click(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            self.menu.popup(self.tray.geometry().center())

    def _on_message_click(self):
        # Clicar no aviso: troca "fixo N%" por "mínimo N%" (sobe se esquentar)
        mode = pf.read_mode("")
        if self.warned and mode.startswith("fixed:"):
            self.set_mode("min:" + mode[6:])

    def check_warning(self, mode, tmax):
        """No modo fixo, avisa uma vez quando passa de warn_temp; rearma 5 °C abaixo."""
        if not mode.startswith("fixed:") or tmax is None:
            self.warned = False
            return
        if mode != self.warn_mode:
            self.warned, self.warn_mode = False, mode
        warn = self.cfg.get()["warn_temp"]
        if not self.warned and tmax >= warn:
            pct = mode[6:]
            self.tray.showMessage(
                "Notebook esquentando",
                f"{tmax:.0f}°C com a ventoinha fixa em {pct}%.\n"
                f"Clique aqui para usar mínimo de {pct}% (sobe se precisar).",
                QSystemTrayIcon.MessageIcon.Warning,
                10000,
            )
            self.warned = True
        elif self.warned and tmax < warn - 5:
            self.warned = False

    def set_mode(self, mode):
        try:
            with open(pf.MODE_FILE, "w") as f:
                f.write(mode)
        except OSError:
            self.tray.showMessage(
                "BenjaBreeze",
                "Serviço não está rodando.\nsudo systemctl start benjabreeze",
                QSystemTrayIcon.MessageIcon.Warning,
            )
        self.refresh()

    def refresh(self):
        t = pf.temps(self.sensors)
        tmax = max(t.values()) if t else None
        fans = []
        if self.hw:
            for i in (1, 2):
                try:
                    fans.append(pf.rd(f"{self.hw}/fan{i}_input"))
                except OSError:
                    fans.append(None)
        active = pf.service_running()
        mode = pf.read_mode("?") if active else "serviço parado"
        want = INTERVAL_AUTO if mode in ("auto", "serviço parado") else INTERVAL_ACTIVE
        if self.timer.interval() != want:
            self.timer.setInterval(want)

        cpu = t.get("cpu_pkg")
        lines = [
            f"CPU: {cpu:.0f}°C" if cpu is not None else "CPU: ?",
            f"Máx. sensores: {tmax:.0f}°C" if tmax is not None else "Sensores: ?",
            "Ventoinhas: " + " / ".join(f"{r} RPM" if r is not None else "?" for r in fans),
            f"Modo: {mode_label(mode)}",
        ]
        self.check_warning(mode, tmax)
        for a, txt in zip(self.info, lines):
            a.setText(txt)
        for key, a in self.actions.items():
            a.setChecked(key == mode)
            a.setEnabled(active)

        # Só redesenha/atualiza quando algo visível mudou
        icon_temp = None if tmax is None else round(tmax)
        if icon_temp != self.last_icon_temp:
            self.tray.setIcon(make_icon(icon_temp))
            self.last_icon_temp = icon_temp
        tip = "BenjaBreeze\n" + "\n".join(lines)
        if tip != self.last_tip:
            self.tray.setToolTip(tip)
            self.last_tip = tip


def main():
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    app.setApplicationName("benjabreeze-tray")
    if not QSystemTrayIcon.isSystemTrayAvailable():
        sys.exit("bandeja do sistema não disponível")
    _t = Tray(app)  # noqa: F841 (mantém referência viva)
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
